{
  "name": "ashour-quiz",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.30.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently \"pnpm --filter @ashour/server dev\" \"pnpm --filter @ashour/web dev\"",
    "build": "pnpm --filter @ashour/web build",
    "start": "tsx packages/server/src/index.ts",
    "seed": "tsx packages/server/src/seed.ts",
    "questions:build": "tsx tools/build-questions.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sim": "tsx tools/simulator.ts",
    "e2e": "tsx tools/e2e.ts",
    "supervise": "node tools/supervise.mjs",
    "smoke": "playwright test -c playwright.config.ts",
    "tour": "tsx tools/tour.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "audit:launch": "tsx tools/launch-audit.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.2",
    "concurrently": "^9.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "ws": "^8.22.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
